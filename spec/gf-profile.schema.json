{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/governance-failure-patterns/spec/gf-profile.schema.json",
  "title": "Governance Fragility Profile",
  "description": "A machine-readable profile for recording governance failure pattern exposure, evidence, and test outcomes.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "profile_id",
    "subject",
    "assessment",
    "layers",
    "anti_patterns",
    "evidence_summary"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "0.1"
    },
    "profile_id": {
      "type": "string",
      "minLength": 1
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "type",
        "scope_statement"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "enum": [
            "policy_tool",
            "agent_system",
            "institutional_workflow",
            "measurement_stack",
            "governance_framework",
            "case_study"
          ]
        },
        "scope_statement": {
          "type": "string",
          "minLength": 1
        },
        "sector": {
          "type": "string"
        },
        "owner": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      }
    },
    "assessment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "date",
        "assessor",
        "status"
      ],
      "properties": {
        "date": {
          "type": "string",
          "format": "date"
        },
        "assessor": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "enum": [
            "draft",
            "internal_review",
            "published"
          ]
        },
        "method_version": {
          "type": "string"
        }
      }
    },
    "layers": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "normative_governance",
        "measurement_substrate",
        "deliberative_layer"
      ],
      "properties": {
        "normative_governance": {
          "$ref": "#/$defs/layerSummary"
        },
        "measurement_substrate": {
          "$ref": "#/$defs/layerSummary"
        },
        "deliberative_layer": {
          "$ref": "#/$defs/layerSummary"
        }
      }
    },
    "governance_shape": {
      "$ref": "#/$defs/governanceShape"
    },
    "operating_envelope": {
      "$ref": "#/$defs/operatingEnvelope"
    },
    "lifecycle_validation": {
      "$ref": "#/$defs/lifecycleValidation"
    },
    "risk_profile": {
      "$ref": "#/$defs/riskProfile"
    },
    "failure_classes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/failureClassRef"
      },
      "default": []
    },
    "anti_patterns": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/antiPatternAssessment"
      }
    },
    "evidence_summary": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/evidenceItem"
      }
    },
    "residual_risk": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "demotion_backlog": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/remediationItem"
      },
      "default": []
    },
    "links": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/linkItem"
      },
      "default": []
    },
    "attestation": {
      "$ref": "#/$defs/attestationRef"
    }
  },
  "$defs": {
    "layerSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "description",
        "evidence_level",
        "confidence"
      ],
      "properties": {
        "description": {
          "type": "string",
          "minLength": 1
        },
        "evidence_level": {
          "$ref": "#/$defs/evidenceLevel"
        },
        "confidence": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high"
          ]
        }
      }
    },
    "governanceShape": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "summary"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "validated_assumptions": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "control_points": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        }
      }
    },
    "operatingEnvelope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "approved_conditions": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "departure_signals": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "intervention_rules": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        }
      }
    },
    "lifecycleValidation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "pre_deployment_validated": {
          "type": "boolean"
        },
        "deployment_gate_defined": {
          "type": "boolean"
        },
        "runtime_monitoring_defined": {
          "type": "boolean"
        },
        "out_of_envelope_response_defined": {
          "type": "boolean"
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "riskProfile": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "summary": {
          "type": "string"
        },
        "authority": {
          "$ref": "#/$defs/riskDimension"
        },
        "reach": {
          "$ref": "#/$defs/riskDimension"
        },
        "reversibility": {
          "$ref": "#/$defs/riskDimension"
        },
        "coupling": {
          "$ref": "#/$defs/riskDimension"
        },
        "consequence": {
          "$ref": "#/$defs/riskDimension"
        },
        "composition": {
          "$ref": "#/$defs/riskDimension"
        }
      }
    },
    "riskDimension": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "level",
        "notes"
      ],
      "properties": {
        "level": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high",
            "critical",
            "unknown"
          ]
        },
        "notes": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "failureClassRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "status"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^F[0-9]{3}$"
        },
        "status": {
          "type": "string",
          "enum": [
            "in_scope",
            "present",
            "not_present",
            "unclear"
          ]
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "antiPatternAssessment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "status",
        "evidence_level",
        "tests"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^AP[0-9]{3}$"
        },
        "status": {
          "type": "string",
          "enum": [
            "present",
            "demoted",
            "not_present",
            "indeterminate"
          ]
        },
        "evidence_level": {
          "$ref": "#/$defs/evidenceLevel"
        },
        "summary": {
          "type": "string"
        },
        "linked_failure_classes": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^F[0-9]{3}$"
          },
          "default": []
        },
        "tests": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/testResult"
          }
        }
      }
    },
    "testResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "test_id",
        "result"
      ],
      "properties": {
        "test_id": {
          "type": "string",
          "pattern": "^AP[0-9]{3}-T[0-9]+$"
        },
        "result": {
          "type": "string",
          "enum": [
            "pass",
            "fail",
            "indeterminate",
            "not_run"
          ]
        },
        "notes": {
          "type": "string"
        },
        "artifact_refs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "evidence_level": {
          "$ref": "#/$defs/evidenceLevel"
        }
      }
    },
    "evidenceItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "description"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "public_source_review",
            "architecture_inspection",
            "document_review",
            "replay_test",
            "perturbation_test",
            "drill_or_exercise",
            "identity_review",
            "monitoring_review",
            "policy_stack_review",
            "private_internal_research",
            "case_study"
          ]
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "uri": {
          "type": "string"
        }
      }
    },
    "remediationItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "priority",
        "status"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "priority": {
          "type": "string",
          "enum": [
            "high",
            "medium",
            "low"
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "proposed",
            "accepted",
            "in_progress",
            "done"
          ]
        },
        "linked_anti_pattern": {
          "type": "string",
          "pattern": "^AP[0-9]{3}$"
        }
      }
    },
    "linkItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "target"
      ],
      "properties": {
        "label": {
          "type": "string"
        },
        "target": {
          "type": "string"
        }
      }
    },
    "attestationRef": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "none",
            "draft",
            "signed",
            "expired"
          ]
        },
        "signed_by": {
          "type": "string"
        },
        "attestation_uri": {
          "type": "string"
        },
        "valid_until": {
          "type": "string",
          "format": "date"
        }
      }
    },
    "evidenceLevel": {
      "type": "string",
      "enum": [
        "public",
        "mixed",
        "private_internal",
        "reproducible",
        "attested"
      ]
    }
  }
}
